# 本地开发环境配置模板（复制为 .env 后填写，.env 不提交）
APP_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_research
REDIS_URL=redis://localhost:6380
QDRANT_URL=http://localhost:6333

# 方舟（DeepSeek）大模型 Key：LLM 与 M3.2 向量化 embedding 共用；留空则知识库跳过向量化（检索退纯全文，配置 Key 后可重新学习补齐）
ARK_API_KEY=
# rerank 精排专用轻量模型（与生成模型解耦；排序无需推理模型，代码内自动关闭思考模式）
# RERANK_LLM_MODEL=deepseek-v4-flash-ga-260731
# 意图分类+查询重写专用轻量模型（同为轻量语义任务，代码内自动关闭思考模式）
# INTENT_LLM_MODEL=deepseek-v4-flash-ga-260731
# 可选：embedding 模型名（OpenAI 兼容 /embeddings），默认 doubao-embedding-large
# EMBED_MODEL=doubao-embedding-large
# 可选：报告导出 PDF 的中文字体文件路径。未配置时按平台自动查找常见中文字体（Windows 微软雅黑、
# Linux 思源黑体/文泉驿、macOS 苹方）；生产容器建议显式指定并确保镜像内已安装中文字体
# PDF_FONT_PATH=

# 联网搜索（AnySearch 直连）：认证模式填 Key，留空则匿名模式（按 IP 限流，额度较低）
ANYSEARCH_API_KEY=
# 可选：覆盖默认基地址 https://api.anysearch.com/v1/search
# ANYSEARCH_BASE_URL=
# 知识库优先匹配（混合模式）：知识库命中「条数 ≥ 且 最高相似度 ≥」才短路不联网，否则补跑联网+垂直兜底
# 注意：两项都设为 0 会导致知识库零命中时也短路（仅联调测试用，生产勿设 0）
# KB_FIRST_MIN_HITS=3
# KB_FIRST_MIN_SCORE=0.5

# 支付渠道密钥加密 Key（A-20：AES-256-GCM 加密 pay_channel_configs.secret_enc；未配置则回退 PAY_MOCK_SECRET 同源密钥并告警）
# SECRET_ENC_KEY=

# 接口限流（M7.2 令牌桶）：以下为环境变量兜底值，运行时可在管理端「参数配置」改 rate.* 键覆盖（30s 生效）
# 总开关：false 关闭限流（压测/联调按需）
# RATE_LIMIT_ENABLED=true
# 登录/验证码（IP 维度）：速率(令牌/秒) / 突发上限(桶容量)
# RATE_AUTH_RATE=0.5
# RATE_AUTH_BURST=30
# 普通读写接口（用户维度）：速率 / 突发上限
# RATE_GLOBAL_RATE=5
# RATE_GLOBAL_BURST=300
# SSE 长连接每用户并发上限
# RATE_SSE_MAX_CONCURRENT=3

# SSE 心跳间隔（毫秒）：空闲期定期写注释帧防网关掐断半开连接；<=0 禁用
# SSE_HEARTBEAT_MS=15000

# 数据备份（M7.4 真实执行 pg_dump）：以下为 docker exec 容器内备份的连接信息，默认值已适配 docker-compose
# 备份文件落盘目录（相对 backend/ 或绝对路径）
# BACKUP_DIR=backups
# PG 容器名 / 用户名 / 库名
# BACKUP_PG_CONTAINER=ai-postgres
# BACKUP_PG_USER=postgres
# BACKUP_PG_DB=ai_research
