# ===== 应用 =====
# API 服务端口
APP_PORT=3000

# ===== 基础设施（docker-compose.yml 默认值） =====
# PostgreSQL 连接串（宿主机端口 5433，避免与其他项目冲突）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_research
# Redis 连接串（宿主机端口 6380，避免与其他项目冲突）
REDIS_URL=redis://localhost:6380
# Qdrant 地址
QDRANT_URL=http://localhost:6333

# ===== 外部服务（后续里程碑启用，此处仅模板） =====
# 阿里云 DashScope（M2 智搜）
# DASHSCOPE_API_KEY=
# 主力模型：意图分类
# LLM_INTENT_MODEL=qwen-max
# 主力模型：报告生成
# LLM_GENERATE_MODEL=qwen-plus
# 备选 Provider（DeepSeek，OpenAI 兼容）
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# 博查搜索 API（M2 联网路）
# BOCHA_API_KEY=
# 阿里云短信（M1 认证）
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# ===== JWT（M1 认证启用） =====
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
