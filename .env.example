# ===== 应用 =====
# API 服务端口
APP_PORT=3000

# ===== 基础设施（docker-compose.yml 默认值） =====
# PostgreSQL 连接串（宿主机端口 5433，避免与其他项目冲突）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_research
# Redis 连接串（宿主机端口 6380，避免与其他项目冲突）
REDIS_URL=redis://localhost:6380
# Qdrant 地址
QDRANT_URL=http://localhost:6333

# ===== 外部服务（后续里程碑启用，此处仅模板） =====
# 火山方舟（M2 智搜 LLM：意图分类 + 报告生成 + M3 向量 embedding，OpenAI 兼容协议）
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 主力模型：意图分类 + 报告生成（方舟托管 DeepSeek-V4-Pro-GA 稳定版）
# LLM_MODEL=deepseek-v4-pro-ga-260813
# 备选模型：方舟豆包 Seed（同平台，仅切 model 即可）
# LLM_FALLBACK_MODEL=doubao-seed-2-1-pro
# AnySearch 联网搜索 API（M2 联网路，认证免费 1000 次/天，留空走匿名模式）
# ANYSEARCH_API_KEY=
# 阿里云短信（M1 认证，开发期日志输出兜底暂缓）
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# ===== JWT（M1 认证启用） =====
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# ===== 支付（M5 会员计费） =====
# MOCK 渠道回调验签密钥（生产替换为真实渠道密钥；未配置用开发默认值并打印告警）
# PAY_MOCK_SECRET=dev-mock-secret-change-me
# 前端站点地址（生成 MOCK 收银台跳转链接）
# WEB_BASE_URL=http://localhost:5173

# ===== 开发期开关 =====
# 是否开放开发期免验证码登录 POST /auth/dev-login（绕过短信 60s 限流，仅联调/测试用，生产必须为 false）
# DEV_LOGIN_ENABLED=false
